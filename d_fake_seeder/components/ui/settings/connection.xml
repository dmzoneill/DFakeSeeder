<?xml version="1.0" encoding="UTF-8"?>
<object class="GtkScrolledWindow" id="settings_connection_scroll">
    <property name="hscrollbar-policy">never</property>
    <property name="vscrollbar-policy">automatic</property>
    <child>
        <object class="GtkBox" id="settings_connection_box">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>

            <!-- Listening Port Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Listening Port"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Port number -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Port:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">20</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="settings_listening_port">
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">1024</property>
                                                    <property name="upper">65535</property>
                                                    <property name="value">6881</property>
                                                    <property name="step-increment">1</property>
                                                    <property name="page-increment">10</property>
                                                </object>
                                            </property>
                                            <property name="tooltip-text" translatable="yes">Port for incoming BitTorrent connections (1024-65535)</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">8</property>
                                            <property name="numeric">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkButton" id="settings_random_port_button">
                                            <property name="label" translatable="yes">Random</property>
                                            <property name="tooltip-text" translatable="yes">Generate a random port number</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- UPnP/NAT-PMP -->
                            <dfs-use template="switch-row" id="settings_upnp_enabled"
                                     tooltip="Automatically configure router port forwarding using UPnP/NAT-PMP"
                                     label="Enable UPnP/NAT-PMP port mapping"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Connection Limits Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Connection Limits"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Max global connections -->
                            <dfs-use template="spin-row-sized" label="Max global connections:" label_chars="20"
                                     id="settings_max_global_connections" lower="1" upper="9999" value="200" step="1"
                                     page="10" tooltip="Maximum number of connections to all torrents" chars="8"/>

                            <!-- Max connections per torrent -->
                            <dfs-use template="spin-row-sized" label="Max per torrent:" label_chars="20"
                                     id="settings_max_per_torrent" lower="1" upper="999" value="50" step="1" page="10"
                                     tooltip="Maximum number of connections per individual torrent" chars="8"/>

                            <!-- Max upload slots -->
                            <dfs-use template="spin-row-sized" label="Max upload slots:" label_chars="20"
                                     id="settings_max_upload_slots" lower="1" upper="999" value="4" step="1" page="5"
                                     tooltip="Maximum number of simultaneous upload slots" chars="8"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Proxy Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Proxy Settings"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Proxy type -->
                            <dfs-use template="dropdown-row" label="Type:" label_chars="15" id="settings_proxy_type"
                                     items="None|HTTP|SOCKS5|SOCKS4" tooltip="Select proxy type for connections"/>

                            <!-- Proxy server -->
                            <dfs-use template="entry-row" label="Server:" label_chars="15" id="settings_proxy_server"
                                     placeholder="proxy.example.com" tooltip="Proxy server hostname or IP address"/>

                            <!-- Proxy port -->
                            <dfs-use template="spin-row-sized" label="Port:" label_chars="15" id="settings_proxy_port"
                                     lower="1" upper="65535" value="8080" step="1" page="10"
                                     tooltip="Proxy server port number" chars="8"/>

                            <!-- Proxy authentication -->
                            <dfs-use template="switch-row" id="settings_proxy_auth_enabled"
                                     tooltip="Enable proxy authentication" label="Use authentication"/>

                            <!-- Proxy username -->
                            <child>
                                <object class="GtkBox" id="settings_proxy_auth_box">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <property name="sensitive">False</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Username:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">15</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkEntry" id="settings_proxy_username">
                                            <property name="placeholder-text" translatable="yes">username</property>
                                            <property name="tooltip-text" translatable="yes">Proxy authentication username</property>
                                            <property name="hexpand">True</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Proxy password -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <property name="sensitive">False</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Password:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">15</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkPasswordEntry" id="settings_proxy_password">
                                            <property name="placeholder-text" translatable="yes">password</property>
                                            <property name="tooltip-text" translatable="yes">Proxy authentication password</property>
                                            <property name="hexpand">True</property>
                                            <property name="show-peek-icon">True</property>
                                        </object>
                                    </child>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
</object>
