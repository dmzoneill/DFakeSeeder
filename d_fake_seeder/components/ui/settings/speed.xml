<?xml version="1.0" encoding="UTF-8"?>
<object class="GtkScrolledWindow" id="settings_speed_scroll">
    <property name="hscrollbar-policy">never</property>
    <property name="vscrollbar-policy">automatic</property>
    <child>
        <object class="GtkBox" id="settings_speed_box">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>

            <!-- Global Speed Limits Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Global Speed Limits"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Upload limit -->
                            <dfs-use template="spin-row-hint" label="Upload limit (KB/s):" id="settings_upload_limit"
                                     lower="0" upper="999999" value="0" step="1" page="10"
                                     tooltip="Global upload speed limit in KB/s (0 = unlimited)"
                                     hint="(0 = unlimited)"/>

                            <!-- Download limit -->
                            <dfs-use template="spin-row-hint" label="Download limit (KB/s):"
                                     id="settings_download_limit" lower="0" upper="999999" value="0" step="1"
                                     page="10" tooltip="Global download speed limit in KB/s (0 = unlimited)"
                                     hint="(0 = unlimited)"/>
                                </object>
                    </child>
                </object>
            </child>

            <!-- Alternative Speed Limits Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Alternative Speed Limits"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable alternative speeds -->
                            <dfs-use template="switch-row" id="settings_enable_alt_speeds"
                                     tooltip="Enable alternative speed limits (useful for limiting speeds during certain hours)"
                                     label="Enable alternative speed limits"/>

                            <!-- Alternative speed settings -->
                            <child>
                                <object class="GtkBox" id="settings_alt_speed_box">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <property name="sensitive">False</property>

                                    <!-- Alt upload limit -->
                                    <dfs-use template="spin-row" label="Alt upload limit (KB/s):"
                                             id="settings_alt_upload_limit" lower="0" upper="999999" value="50"
                                             step="1" page="10" tooltip="Alternative upload speed limit in KB/s"/>
                                    <!-- Alt download limit -->
                                    <dfs-use template="spin-row" label="Alt download limit (KB/s):"
                                             id="settings_alt_download_limit" lower="0" upper="999999" value="100"
                                             step="1" page="10" tooltip="Alternative download speed limit in KB/s"/>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Speed Scheduler Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Speed Scheduler"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable scheduler -->
                            <dfs-use template="switch-row" id="settings_enable_scheduler"
                                     tooltip="Automatically switch to alternative speeds during specified hours"
                                     label="Enable speed scheduler"/>

                            <!-- Scheduler settings -->
                            <child>
                                <object class="GtkBox" id="settings_scheduler_box">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <property name="sensitive">False</property>

                                    <!-- Time range -->
                                    <child>
                                        <object class="GtkBox">
                                            <property name="spacing">12</property>
                                            <property name="halign">fill</property>
                                            <child>
                                                <object class="GtkLabel">
                                                    <property name="label" translatable="yes">From:</property>
                                                    <property name="halign">start</property>
                                                    <property name="valign">center</property>
                                                    <property name="hexpand">False</property>
                                                    <property name="width-chars">8</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkSpinButton" id="settings_scheduler_start_hour">
                                                    <property name="adjustment">
                                                        <object class="GtkAdjustment">
                                                            <property name="lower">0</property>
                                                            <property name="upper">23</property>
                                                            <property name="value">22</property>
                                                            <property name="step-increment">1</property>
                                                            <property name="page-increment">1</property>
                                                        </object>
                                                    </property>
                                                    <property name="tooltip-text" translatable="yes">Start hour (24-hour format)</property>
                                                    <property name="hexpand">False</property>
                                                    <property name="width-chars">4</property>
                                                    <property name="numeric">True</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkLabel">
                                                    <property name="label" translatable="yes">:</property>
                                                    <property name="halign">center</property>
                                                    <property name="valign">center</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkSpinButton" id="settings_scheduler_start_minute">
                                                    <property name="adjustment">
                                                        <object class="GtkAdjustment">
                                                            <property name="lower">0</property>
                                                            <property name="upper">59</property>
                                                            <property name="value">0</property>
                                                            <property name="step-increment">1</property>
                                                            <property name="page-increment">5</property>
                                                        </object>
                                                    </property>
                                                    <property name="tooltip-text" translatable="yes">Start minute</property>
                                                    <property name="hexpand">False</property>
                                                    <property name="width-chars">4</property>
                                                    <property name="numeric">True</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkLabel">
                                                    <property name="label" translatable="yes">To:</property>
                                                    <property name="halign">start</property>
                                                    <property name="valign">center</property>
                                                    <property name="margin-start">20</property>
                                                    <property name="width-chars">8</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkSpinButton" id="settings_scheduler_end_hour">
                                                    <property name="adjustment">
                                                        <object class="GtkAdjustment">
                                                            <property name="lower">0</property>
                                                            <property name="upper">23</property>
                                                            <property name="value">6</property>
                                                            <property name="step-increment">1</property>
                                                            <property name="page-increment">1</property>
                                                        </object>
                                                    </property>
                                                    <property name="tooltip-text" translatable="yes">End hour (24-hour format)</property>
                                                    <property name="hexpand">False</property>
                                                    <property name="width-chars">4</property>
                                                    <property name="numeric">True</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkLabel">
                                                    <property name="label" translatable="yes">:</property>
                                                    <property name="halign">center</property>
                                                    <property name="valign">center</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkSpinButton" id="settings_scheduler_end_minute">
                                                    <property name="adjustment">
                                                        <object class="GtkAdjustment">
                                                            <property name="lower">0</property>
                                                            <property name="upper">59</property>
                                                            <property name="value">0</property>
                                                            <property name="step-increment">1</property>
                                                            <property name="page-increment">5</property>
                                                        </object>
                                                    </property>
                                                    <property name="tooltip-text" translatable="yes">End minute</property>
                                                    <property name="hexpand">False</property>
                                                    <property name="width-chars">4</property>
                                                    <property name="numeric">True</property>
                                                </object>
                                            </child>
                                        </object>
                                    </child>

                                    <!-- Days selection -->
                                    <child>
                                        <object class="GtkBox">
                                            <property name="spacing">8</property>
                                            <property name="halign">start</property>
                                            <child>
                                                <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Days:</property>
                                                    <property name="halign">start</property>
                                                    <property name="valign">center</property>
                                                    <property name="width-chars">8</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkBox">
                                                    <property name="spacing">4</property>
                                                    <dfs-use template="labelled-check" id="settings_scheduler_mon"
                                                             label="Mon" tooltip="Monday"/>
                                                    <dfs-use template="labelled-check" id="settings_scheduler_tue"
                                                             label="Tue" tooltip="Tuesday"/>
                                                    <dfs-use template="labelled-check" id="settings_scheduler_wed"
                                                             label="Wed" tooltip="Wednesday"/>
                                                    <dfs-use template="labelled-check" id="settings_scheduler_thu"
                                                             label="Thu" tooltip="Thursday"/>
                                                    <dfs-use template="labelled-check" id="settings_scheduler_fri"
                                                             label="Fri" tooltip="Friday"/>
                                                    <dfs-use template="labelled-check" id="settings_scheduler_sat"
                                                             label="Sat" tooltip="Saturday"/>
                                                    <dfs-use template="labelled-check" id="settings_scheduler_sun"
                                                             label="Sun" tooltip="Sunday"/>
                                </object>
                                            </child>
                                        </object>
                                    </child>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Speed Distribution Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Speed Distribution"/>

                    <!-- Info message about redistribution timing -->
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <child>
                                <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">12</property>
                                    <property name="css-classes">info-box</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label">ℹ️</property>
                                            <property name="valign">start</property>
                                            <property name="margin-top">2</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Note: Choosing "Tick speed" redistribution may result in averaged values appearing on the tracker due to the law of large numbers. Multiple redistributions occur between tracker announces, causing individual torrent speeds to balance out over time. For non-uniform tracker statistics, use "Announce Interval" redistribution mode.</property>
                                            <property name="wrap">True</property>
                                            <property name="wrap-mode">word</property>
                                            <property name="xalign">0</property>
                                            <property name="max-width-chars">80</property>
                                            <property name="css-classes">dim-label</property>
                                        </object>
                                    </child>
                                </object>
                            </child>
                        </object>
                    </child>

                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">18</property>
                            <property name="margin-start">12</property>

                            <!-- Upload Distribution -->
                            <dfs-use template="speed-distribution" dir="upload" Dir="Upload"/>

                            <!-- Download Distribution -->
                            <dfs-use template="speed-distribution" dir="download" Dir="Download"/>
                                </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
</object>