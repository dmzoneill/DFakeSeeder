<?xml version="1.0" encoding="UTF-8"?>
<object class="GtkScrolledWindow" id="settings_dht_scroll">
    <property name="hscrollbar-policy">never</property>
    <property name="vscrollbar-policy">automatic</property>
    <child>
        <object class="GtkBox" id="settings_dht_box">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>

            <!-- DHT Enable/Disable Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="DHT (Distributed Hash Table)"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable DHT -->
                            <dfs-use template="switch-row" id="dht_enabled_switch"
                                     tooltip="Enable or disable DHT for trackerless torrent support"
                                     label="Enable DHT"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Node Configuration Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Node Configuration"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Auto-generate node ID -->
                            <dfs-use template="check-row" id="node_id_auto_check" active="True"
                                     tooltip="Automatically generate a unique node ID" label="Auto-generate node ID"/>

                            <!-- Custom node ID -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Custom Node ID:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">18</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkEntry" id="node_id_custom_entry">
                                            <property name="placeholder-text" translatable="yes">40 hexadecimal characters (20 bytes)</property>
                                            <property name="tooltip-text" translatable="yes">Custom node ID (40 hex characters)</property>
                                            <property name="hexpand">True</property>
                                            <property name="sensitive">False</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Routing table size -->
                            <dfs-use template="spin-row-fill" label="Routing Table Size:" label_chars="18"
                                     id="routing_table_size_spin" lower="8" upper="512" step="8" page="32" value="160"
                                     tooltip="Maximum number of nodes in the routing table"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Timing Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Timing Settings"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Announcement interval -->
                            <dfs-use template="spin-row-fill-unit" label="Announcement Interval:" label_chars="18"
                                     id="dht_announcement_interval_spin" lower="300" upper="7200" step="60" page="300"
                                     value="1800" tooltip="Interval between DHT announcements (seconds)"
                                     unit="seconds"/>

                            <!-- Bootstrap timeout -->
                            <dfs-use template="spin-row-fill-unit" label="Bootstrap Timeout:" label_chars="18"
                                     id="bootstrap_timeout_spin" lower="5" upper="300" step="5" page="30" value="30"
                                     tooltip="Timeout for DHT bootstrap operations (seconds)" unit="seconds"/>

                            <!-- Query timeout -->
                            <dfs-use template="spin-row-fill-unit" label="Query Timeout:" label_chars="18"
                                     id="dht_query_timeout_spin" lower="5" upper="120" step="5" page="15" value="10"
                                     tooltip="Timeout for DHT queries (seconds)" unit="seconds"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Network Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Network Settings"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Max nodes -->
                            <dfs-use template="spin-row-fill" label="Max Nodes:" label_chars="18"
                                     id="dht_max_nodes_spin" lower="100" upper="5000" step="50" page="500"
                                     value="1000" tooltip="Maximum number of DHT nodes to maintain"/>

                            <!-- Bucket size -->
                            <dfs-use template="spin-row-fill" label="Bucket Size:" label_chars="18"
                                     id="dht_bucket_size_spin" lower="4" upper="20" step="1" page="2" value="8"
                                     tooltip="Maximum number of nodes per bucket"/>

                            <!-- Concurrent queries -->
                            <dfs-use template="spin-row-fill" label="Concurrent Queries:" label_chars="18"
                                     id="dht_concurrent_queries_spin" lower="1" upper="10" step="1" page="1" value="3"
                                     tooltip="Maximum number of concurrent DHT queries"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Bootstrap Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Bootstrap Settings"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Auto bootstrap -->
                            <dfs-use template="check-row" id="auto_bootstrap_check" active="True"
                                     tooltip="Automatically bootstrap DHT using known nodes"
                                     label="Auto-bootstrap DHT"/>

                            <!-- Bootstrap nodes -->
                            <child>
                                <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Bootstrap Nodes (one per line, format: host:port):</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkFrame">
                                            <property name="child">
                                                <object class="GtkScrolledWindow">
                                                    <property name="height-request">120</property>
                                                    <property name="hscrollbar-policy">automatic</property>
                                                    <property name="vscrollbar-policy">automatic</property>
                                                    <child>
                                                        <object class="GtkTextView" id="bootstrap_nodes_textview">
                                                            <property name="tooltip-text" translatable="yes">List of bootstrap nodes for DHT initialization</property>
                                                            <property name="monospace">True</property>
                                                        </object>
                                                    </child>
                                                </object>
                                            </property>
                                        </object>
                                    </child>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Statistics and Security Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Statistics and Security"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Enable statistics -->
                            <dfs-use template="check-row" id="dht_enable_stats_check" active="True"
                                     tooltip="Enable DHT statistics collection" label="Enable statistics"/>

                            <!-- Statistics interval -->
                            <dfs-use template="spin-row-fill-unit" label="Stats Update Interval:" label_chars="18"
                                     id="dht_stats_interval_spin" lower="10" upper="600" step="10" page="60"
                                     value="60" tooltip="Interval for DHT statistics updates (seconds)" unit="seconds"/>

                            <!-- Validate tokens -->
                            <dfs-use template="check-row" id="dht_validate_tokens_check" active="True"
                                     tooltip="Validate DHT security tokens" label="Validate security tokens"/>

                            <!-- Rate limiting -->
                            <dfs-use template="check-row" id="dht_rate_limit_check" active="True"
                                     tooltip="Enable DHT query rate limiting" label="Enable rate limiting"/>

                            <!-- Max queries per second -->
                            <dfs-use template="spin-row-fill" label="Max Queries/Second:" label_chars="18"
                                     id="dht_max_queries_spin" lower="1" upper="100" step="1" page="5" value="10"
                                     tooltip="Maximum DHT queries per second"/>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
</object>