<?xml version="1.0" encoding="UTF-8"?>
<object class="GtkScrolledWindow" id="settings_peer_protocol_scroll">
    <property name="hscrollbar-policy">never</property>
    <property name="vscrollbar-policy">automatic</property>
    <child>
        <object class="GtkBox" id="settings_peer_protocol_box">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>

            <!-- Peer Protocol Timeouts Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;Peer Protocol Timeouts&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Handshake timeout -->
                            <dfs-use template="spin-row-decimal" label="Handshake timeout (seconds):" label_chars="25"
                                     id="settings_handshake_timeout" lower="1.0" upper="300.0" value="30.0" step="1.0"
                                     page="5.0" digits="1" tooltip="Timeout for peer handshake in seconds" chars="8"/>

                            <!-- Message read timeout -->
                            <dfs-use template="spin-row-decimal" label="Message read timeout (seconds):"
                                     label_chars="25" id="settings_message_read_timeout" lower="1.0" upper="600.0"
                                     value="60.0" step="1.0" page="10.0" digits="1"
                                     tooltip="Timeout for reading peer messages in seconds" chars="8"/>

                            <!-- Keep alive interval -->
                            <dfs-use template="spin-row-decimal" label="Keep alive interval (seconds):"
                                     label_chars="25" id="settings_keep_alive_interval" lower="10.0" upper="600.0"
                                     value="120.0" step="10.0" page="30.0" digits="1"
                                     tooltip="Interval for sending keep alive messages in seconds" chars="8"/>

                            <!-- Peer contact interval -->
                            <dfs-use template="spin-row-decimal" label="Peer contact interval (seconds):"
                                     label_chars="25" id="settings_peer_contact_interval" lower="30.0" upper="3600.0"
                                     value="300.0" step="30.0" page="60.0" digits="1"
                                     tooltip="Interval for contacting peers in seconds" chars="8"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Seeder Protocol Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;Seeder Protocol Settings&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- UDP seeder timeout -->
                            <dfs-use template="spin-row-decimal" label="UDP seeder timeout (seconds):"
                                     label_chars="25" id="settings_udp_seeder_timeout" lower="1.0" upper="60.0"
                                     value="5.0" step="1.0" page="5.0" digits="1"
                                     tooltip="Timeout for UDP seeder connections in seconds" chars="8"/>

                            <!-- HTTP seeder timeout -->
                            <dfs-use template="spin-row-decimal" label="HTTP seeder timeout (seconds):"
                                     label_chars="25" id="settings_http_seeder_timeout" lower="1.0" upper="120.0"
                                     value="10.0" step="1.0" page="5.0" digits="1"
                                     tooltip="Timeout for HTTP seeder connections in seconds" chars="8"/>

                            <!-- Seeder port range -->
                            <dfs-use template="spin-row-sized" label="Seeder port range (min):" label_chars="25"
                                     id="settings_seeder_port_min" lower="1024" upper="65534" value="1025" step="1"
                                     page="100" tooltip="Minimum port for seeder connections" chars="8"/>

                            <dfs-use template="spin-row-sized" label="Seeder port range (max):" label_chars="25"
                                     id="settings_seeder_port_max" lower="1025" upper="65535" value="65000" step="1"
                                     page="100" tooltip="Maximum port for seeder connections" chars="8"/>

                            <!-- Transaction ID range -->
                            <dfs-use template="spin-row-sized" label="Transaction ID range (min):" label_chars="25"
                                     id="settings_transaction_id_min" lower="0" upper="254" value="0" step="1"
                                     page="10" tooltip="Minimum transaction ID for tracker communication" chars="8"/>

                            <dfs-use template="spin-row-sized" label="Transaction ID range (max):" label_chars="25"
                                     id="settings_transaction_id_max" lower="1" upper="255" value="255" step="1"
                                     page="10" tooltip="Maximum transaction ID for tracker communication" chars="8"/>

                            <!-- Peer request count -->
                            <dfs-use template="spin-row-sized" label="Peer request count:" label_chars="25"
                                     id="settings_peer_request_count" lower="1" upper="1000" value="200" step="1"
                                     page="10" tooltip="Number of peers to request from tracker" chars="8"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Peer Behavior Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;Peer Behavior Settings&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Upload activity probability -->
                            <dfs-use template="spin-row-decimal" label="Upload activity probability:" label_chars="25"
                                     id="settings_seeder_upload_activity_probability" lower="0.0" upper="1.0"
                                     value="0.3" step="0.01" page="0.1" digits="2"
                                     tooltip="Probability of seeder upload activity (0.0 - 1.0)" chars="8"/>

                            <!-- Peer idle chance -->
                            <dfs-use template="spin-row-decimal" label="Peer idle chance:" label_chars="25"
                                     id="settings_peer_idle_chance" lower="0.0" upper="1.0" value="0.3" step="0.01"
                                     page="0.1" digits="2" tooltip="Probability of peer being idle (0.0 - 1.0)"
                                     chars="8"/>

                            <!-- Progress distribution settings -->
                            <dfs-use template="spin-row-decimal" label="Progress distribution (start):"
                                     label_chars="25" id="settings_progress_distribution_start" lower="0.0"
                                     upper="1.0" value="0.1" step="0.01" page="0.1" digits="2"
                                     tooltip="Progress distribution for starting peers (0.0 - 1.0)" chars="8"/>

                            <dfs-use template="spin-row-decimal" label="Progress distribution (middle):"
                                     label_chars="25" id="settings_progress_distribution_middle" lower="0.0"
                                     upper="1.0" value="0.3" step="0.01" page="0.1" digits="2"
                                     tooltip="Progress distribution for middle progress peers (0.0 - 1.0)" chars="8"/>

                            <dfs-use template="spin-row-decimal" label="Progress distribution (almost):"
                                     label_chars="25" id="settings_progress_distribution_almost" lower="0.0"
                                     upper="1.0" value="0.7" step="0.01" page="0.1" digits="2"
                                     tooltip="Progress distribution for almost complete peers (0.0 - 1.0)" chars="8"/>

                            <!-- Behavior analysis probability -->
                            <dfs-use template="spin-row-decimal" label="Behavior analysis probability:"
                                     label_chars="25" id="settings_peer_behavior_analysis_probability" lower="0.0"
                                     upper="1.0" value="0.2" step="0.01" page="0.1" digits="2"
                                     tooltip="Probability of peer behavior analysis (0.0 - 1.0)" chars="8"/>

                            <!-- Status change probability -->
                            <dfs-use template="spin-row-decimal" label="Status change probability:" label_chars="25"
                                     id="settings_peer_status_change_probability" lower="0.0" upper="1.0" value="0.4"
                                     step="0.01" page="0.1" digits="2"
                                     tooltip="Probability of peer status changes (0.0 - 1.0)" chars="8"/>

                            <!-- Dropout probability -->
                            <dfs-use template="spin-row-decimal" label="Dropout probability:" label_chars="25"
                                     id="settings_peer_dropout_probability" lower="0.0" upper="1.0" value="0.1"
                                     step="0.01" page="0.1" digits="2"
                                     tooltip="Probability of peer dropping out (0.0 - 1.0)" chars="8"/>

                            <!-- Connection rotation percentage -->
                            <dfs-use template="spin-row-decimal" label="Connection rotation percentage:"
                                     label_chars="25" id="settings_connection_rotation_percentage" lower="0.0"
                                     upper="1.0" value="0.25" step="0.01" page="0.1" digits="2"
                                     tooltip="Percentage of connections to rotate (0.0 - 1.0)" chars="8"/>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
</object>