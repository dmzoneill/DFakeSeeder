<?xml version="1.0" encoding="UTF-8"?>
<object class="GtkScrolledWindow">
    <property name="visible">True</property>
    <property name="vexpand">True</property>
    <property name="hexpand">True</property>
    <property name="hscrollbar-policy">never</property>
    <child>
        <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>

            <!-- Enable Notifications -->
            <dfs-use template="pref-switch" label="Enable popup notifications" id="notification_enabled"
                     tooltip="Show toast notifications in the application"/>

            <!-- Appearance Section -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Appearance"/>
                    <child>
                        <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Position -->
                            <dfs-use template="pref-dropdown" label="Position" id="notification_position"
                                     tooltip="Where notifications appear on screen"
                                     items="Top Left|Top Center|Top Right|Bottom Left|Bottom Center|Bottom Right"/>

                            <!-- Animation -->
                            <dfs-use template="pref-dropdown" label="Animation" id="notification_animation"
                                     tooltip="Animation style for showing/hiding notifications"
                                     items="None|Fade|Slide"/>

                            <!-- Animation Duration -->
                            <dfs-use template="pref-spin" label="Animation duration (ms)"
                                     id="notification_animation_duration" chars="6"
                                     tooltip="Duration of show/hide animation in milliseconds" lower="0" upper="1000"
                                     step="50" page="100" value="300"/>

                            <!-- Max Visible -->
                            <dfs-use template="pref-spin" label="Maximum visible" id="notification_max_visible"
                                     chars="4" tooltip="Maximum number of notifications visible at once" lower="1"
                                     upper="10" step="1" page="1" value="3"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Timeouts Section -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Timeouts (milliseconds, 0 = manual dismiss)"/>
                    <child>
                        <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Info Timeout -->
                            <child>
                                <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">12</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="label" translatable="yes">ℹ️ Info</property>
                                            <property name="halign">start</property>
                                            <property name="hexpand">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="notification_info_timeout">
                                            <property name="visible">True</property>
                                            <property name="halign">end</property>
                                            <property name="width-chars">8</property>
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">0</property>
                                                    <property name="upper">30000</property>
                                                    <property name="step-increment">500</property>
                                                    <property name="page-increment">1000</property>
                                                    <property name="value">3000</property>
                                                </object>
                                            </property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Success Timeout -->
                            <child>
                                <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">12</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="label" translatable="yes">✅ Success</property>
                                            <property name="halign">start</property>
                                            <property name="hexpand">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="notification_success_timeout">
                                            <property name="visible">True</property>
                                            <property name="halign">end</property>
                                            <property name="width-chars">8</property>
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">0</property>
                                                    <property name="upper">30000</property>
                                                    <property name="step-increment">500</property>
                                                    <property name="page-increment">1000</property>
                                                    <property name="value">3000</property>
                                                </object>
                                            </property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Warning Timeout -->
                            <child>
                                <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">12</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="visible">True</property>
                                            <property name="label" translatable="yes">⚠️ Warning</property>
                                            <property name="halign">start</property>
                                            <property name="hexpand">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="notification_warning_timeout">
                                            <property name="visible">True</property>
                                            <property name="halign">end</property>
                                            <property name="width-chars">8</property>
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">0</property>
                                                    <property name="upper">30000</property>
                                                    <property name="step-increment">500</property>
                                                    <property name="page-increment">1000</property>
                                                    <property name="value">5000</property>
                                                </object>
                                            </property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Error Timeout -->
                            <dfs-use template="pref-spin" label="❌ Error" id="notification_error_timeout" chars="8"
                                     tooltip="0 = requires manual dismiss" lower="0" upper="30000" step="500"
                                     page="1000" value="0"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Options Section -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Options"/>
                    <child>
                        <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Show in statusbar -->
                            <dfs-use template="pref-switch" label="Also show in status bar"
                                     id="notification_show_statusbar"
                                     tooltip="Also display notification text in the status bar"/>

                            <!-- Sound -->
                            <dfs-use template="pref-switch" label="Play sound" id="notification_sound"
                                     tooltip="Play a sound when notifications appear"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Test Button -->
            <child>
                <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <property name="halign">center</property>
                    <child>
                        <object class="GtkButton" id="notification_test_button">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Test Notifications</property>
                            <property name="tooltip-text" translatable="yes">Show sample notifications of each type</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkButton" id="notification_reset_button">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Reset to Defaults</property>
                            <property name="tooltip-text" translatable="yes">Reset notification settings to defaults</property>
                        </object>
                    </child>
                </object>
            </child>

        </object>
    </child>
</object>
