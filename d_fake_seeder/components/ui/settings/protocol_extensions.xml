<?xml version="1.0" encoding="UTF-8"?>
<object class="GtkScrolledWindow" id="settings_protocol_extensions_scroll">
    <property name="hscrollbar-policy">never</property>
    <property name="vscrollbar-policy">automatic</property>
    <child>
        <object class="GtkBox" id="settings_protocol_extensions_box">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>

            <!-- Protocol Extensions Enable/Disable Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Protocol Extensions"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable Extensions -->
                            <dfs-use template="switch-row" id="extensions_enabled_switch"
                                     tooltip="Enable or disable BitTorrent protocol extensions"
                                     label="Enable Protocol Extensions"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Extension Protocol (BEP-010) Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Extension Protocol (BEP-010)"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- ut_metadata -->
                            <dfs-use template="check-row" id="ut_metadata_check" active="True"
                                     tooltip="Enable ut_metadata extension for metadata exchange"
                                     label="ut_metadata (Metadata Exchange)"/>

                            <!-- ut_pex -->
                            <dfs-use template="check-row" id="ut_pex_check" active="True"
                                     tooltip="Enable ut_pex extension for peer exchange"
                                     label="ut_pex (Peer Exchange)"/>

                            <!-- lt_donthave -->
                            <dfs-use template="check-row" id="lt_donthave_check" active="True"
                                     tooltip="Enable lt_donthave extension for piece availability"
                                     label="lt_donthave (Piece Availability)"/>

                            <!-- Fast Extension -->
                            <dfs-use template="check-row" id="fast_extension_check" active="True"
                                     tooltip="Enable Fast Extension (BEP-006) for improved performance"
                                     label="Fast Extension (BEP-006)"/>

                            <!-- ut_holepunch -->
                            <dfs-use template="check-row" id="ut_holepunch_check" active="False"
                                     tooltip="Enable ut_holepunch extension for NAT traversal"
                                     label="ut_holepunch (NAT Traversal)"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Peer Exchange (PEX) Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Peer Exchange (PEX) Settings"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- PEX interval -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">PEX Interval:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">18</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="pex_interval_spin">
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">30</property>
                                                    <property name="upper">300</property>
                                                    <property name="step-increment">5</property>
                                                    <property name="page-increment">30</property>
                                                    <property name="value">60</property>
                                                </object>
                                            </property>
                                            <property name="tooltip-text" translatable="yes">Interval between PEX message exchanges (seconds)</property>
                                            <property name="hexpand">True</property>
                                            <property name="numeric">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">seconds</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Max peers per message -->
                            <dfs-use template="spin-row-fill" label="Max Peers/Message:" label_chars="18"
                                     id="pex_max_peers_spin" lower="10" upper="200" step="5" page="25" value="50"
                                     tooltip="Maximum peers to include in a PEX message"/>

                            <!-- Max dropped peers -->
                            <dfs-use template="spin-row-fill" label="Max Dropped Peers:" label_chars="18"
                                     id="pex_max_dropped_spin" lower="5" upper="100" step="5" page="10" value="20"
                                     tooltip="Maximum dropped peers to track for PEX"/>

                            <!-- Generate synthetic peers -->
                            <dfs-use template="check-row" id="pex_synthetic_peers_check" active="True"
                                     tooltip="Generate synthetic peer data for PEX" label="Generate synthetic peers"/>

                            <!-- Synthetic peer count -->
                            <dfs-use template="spin-row-fill" label="Synthetic Peer Count:" label_chars="18"
                                     id="pex_synthetic_count_spin" lower="5" upper="100" step="5" page="10" value="20"
                                     tooltip="Number of synthetic peers to generate"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Metadata Extension Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Metadata Extension Settings"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Enable metadata extension -->
                            <dfs-use template="check-row" id="metadata_enabled_check" active="True"
                                     tooltip="Enable metadata extension features" label="Enable metadata extension"/>

                            <!-- Metadata piece size -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Metadata Piece Size:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">18</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="metadata_piece_size_spin">
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">1024</property>
                                                    <property name="upper">65536</property>
                                                    <property name="step-increment">1024</property>
                                                    <property name="page-increment">4096</property>
                                                    <property name="value">16384</property>
                                                </object>
                                            </property>
                                            <property name="tooltip-text" translatable="yes">Size of metadata pieces in bytes</property>
                                            <property name="hexpand">True</property>
                                            <property name="numeric">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">bytes</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Metadata timeout -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Metadata Timeout:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">18</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="metadata_timeout_spin">
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">10</property>
                                                    <property name="upper">300</property>
                                                    <property name="step-increment">10</property>
                                                    <property name="page-increment">30</property>
                                                    <property name="value">60</property>
                                                </object>
                                            </property>
                                            <property name="tooltip-text" translatable="yes">Timeout for metadata requests (seconds)</property>
                                            <property name="hexpand">True</property>
                                            <property name="numeric">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">seconds</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Synthetic metadata -->
                            <dfs-use template="check-row" id="metadata_synthetic_check" active="True"
                                     tooltip="Generate synthetic metadata for simulation"
                                     label="Generate synthetic metadata"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Transport Protocol Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Transport Protocol Settings"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- µTP enabled -->
                            <dfs-use template="check-row" id="utp_enabled_check" active="False"
                                     tooltip="Enable µTP (Micro Transport Protocol)"
                                     label="Enable µTP (Micro Transport Protocol)"/>

                            <!-- TCP fallback -->
                            <dfs-use template="check-row" id="tcp_fallback_check" active="True"
                                     tooltip="Fall back to TCP if µTP fails" label="TCP fallback"/>

                            <!-- Connection timeout -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Connection Timeout:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">18</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="ext_connection_timeout_spin">
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">5</property>
                                                    <property name="upper">120</property>
                                                    <property name="step-increment">5</property>
                                                    <property name="page-increment">15</property>
                                                    <property name="value">30</property>
                                                </object>
                                            </property>
                                            <property name="tooltip-text" translatable="yes">Connection timeout for extensions (seconds)</property>
                                            <property name="hexpand">True</property>
                                            <property name="numeric">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">seconds</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Keep alive interval -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Keep Alive Interval:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">18</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="ext_keep_alive_spin">
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">30</property>
                                                    <property name="upper">600</property>
                                                    <property name="step-increment">30</property>
                                                    <property name="page-increment">60</property>
                                                    <property name="value">120</property>
                                                </object>
                                            </property>
                                            <property name="tooltip-text" translatable="yes">Keep alive interval for connections (seconds)</property>
                                            <property name="hexpand">True</property>
                                            <property name="numeric">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">seconds</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Nagle algorithm -->
                            <dfs-use template="check-row" id="nagle_algorithm_check" active="False"
                                     tooltip="Enable Nagle algorithm for TCP" label="Enable Nagle algorithm"/>

                            <!-- TCP keepalive -->
                            <dfs-use template="check-row" id="tcp_keepalive_check" active="True"
                                     tooltip="Enable TCP keepalive" label="TCP keepalive"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Advanced Extension Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Advanced Extension Settings"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Extension timeout -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Extension Timeout:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">18</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="extension_timeout_spin">
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">10</property>
                                                    <property name="upper">300</property>
                                                    <property name="step-increment">10</property>
                                                    <property name="page-increment">30</property>
                                                    <property name="value">30</property>
                                                </object>
                                            </property>
                                            <property name="tooltip-text" translatable="yes">General timeout for extension operations (seconds)</property>
                                            <property name="hexpand">True</property>
                                            <property name="numeric">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">seconds</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Max extension message size -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Max Message Size:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">18</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="max_extension_msg_size_spin">
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">1024</property>
                                                    <property name="upper">10485760</property>
                                                    <property name="step-increment">4096</property>
                                                    <property name="page-increment">65536</property>
                                                    <property name="value">1048576</property>
                                                </object>
                                            </property>
                                            <property name="tooltip-text" translatable="yes">Maximum size for extension messages (bytes)</property>
                                            <property name="hexpand">True</property>
                                            <property name="numeric">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">bytes</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Track extension statistics -->
                            <dfs-use template="check-row" id="track_extension_stats_check" active="True"
                                     tooltip="Track extension usage statistics" label="Track extension statistics"/>

                            <!-- Statistics update interval -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Stats Update Interval:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">18</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkSpinButton" id="ext_stats_interval_spin">
                                            <property name="adjustment">
                                                <object class="GtkAdjustment">
                                                    <property name="lower">10</property>
                                                    <property name="upper">600</property>
                                                    <property name="step-increment">10</property>
                                                    <property name="page-increment">60</property>
                                                    <property name="value">60</property>
                                                </object>
                                            </property>
                                            <property name="tooltip-text" translatable="yes">Extension statistics update interval (seconds)</property>
                                            <property name="hexpand">True</property>
                                            <property name="numeric">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">seconds</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Validate extensions -->
                            <dfs-use template="check-row" id="validate_extensions_check" active="True"
                                     tooltip="Validate extension messages for security"
                                     label="Validate extension messages"/>

                            <!-- Limit extension messages -->
                            <dfs-use template="check-row" id="limit_extension_msgs_check" active="True"
                                     tooltip="Limit extension message rate" label="Limit extension message rate"/>

                            <!-- Max messages per second -->
                            <dfs-use template="spin-row-fill" label="Max Messages/Second:" label_chars="18"
                                     id="max_ext_msgs_per_sec_spin" lower="1" upper="200" step="5" page="25"
                                     value="50" tooltip="Maximum extension messages per second"/>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
</object>