<?xml version="1.0" encoding="UTF-8"?>
<object class="GtkScrolledWindow" id="settings_bittorrent_scroll">
    <property name="hscrollbar-policy">never</property>
    <property name="vscrollbar-policy">automatic</property>
    <child>
        <object class="GtkBox" id="settings_bittorrent_box">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>

            <!-- Protocol Features Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Protocol Features"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable DHT -->
                            <dfs-use template="switch-row" id="settings_enable_dht"
                                     tooltip="Enable Distributed Hash Table for trackerless torrents"
                                     label="Enable DHT (Distributed Hash Table)"/>

                            <!-- Enable PEX -->
                            <dfs-use template="switch-row" id="settings_enable_pex"
                                     tooltip="Enable Peer Exchange for discovering new peers"
                                     label="Enable PEX (Peer Exchange)"/>

                            <!-- Enable LPD -->
                            <dfs-use template="switch-row" id="settings_enable_lpd"
                                     tooltip="Enable Local Peer Discovery for finding peers on local network"
                                     label="Enable LPD (Local Peer Discovery)"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Encryption Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Encryption"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Encryption mode -->
                            <dfs-use template="dropdown-row" label="Encryption:" label_chars="15"
                                     id="settings_encryption_mode" items="Disabled|Enabled|Forced"
                                     tooltip="Protocol encryption mode for peer communications"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Client Identification Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Client Identification"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- User Agent -->
                            <dfs-use template="dropdown-row" label="User Agent:" label_chars="15"
                                     id="settings_user_agent"
                                     items="Deluge/2.0.3 libtorrent/2.0.5.0|qBittorrent/4.3.1|Transmission/3.00|uTorrent/3.5.5|Vuze/5.7.6.0|BitTorrent/7.10.5|rTorrent/0.9.6|Custom"
                                     tooltip="User agent string to identify the client to trackers"/>

                            <!-- Custom User Agent -->
                            <child>
                                <object class="GtkBox" id="settings_custom_agent_box">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <property name="sensitive">False</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Custom Agent:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">15</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkEntry" id="settings_custom_user_agent">
                                            <property name="placeholder-text" translatable="yes">MyClient/1.0.0</property>
                                            <property name="tooltip-text" translatable="yes">Custom user agent string</property>
                                            <property name="hexpand">True</property>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Peer ID -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Peer ID Prefix:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">15</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkEntry" id="settings_peer_id_prefix">
                                            <property name="placeholder-text" translatable="yes">-DE2003-</property>
                                            <property name="tooltip-text" translatable="yes">Peer ID prefix to identify client type</property>
                                            <property name="max-length">8</property>
                                            <property name="hexpand">True</property>
                                        </object>
                                    </child>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Announce Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Tracker Announce Settings"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Announce interval -->
                            <dfs-use template="spin-row-sized" label="Announce interval (sec):" label_chars="20"
                                     id="settings_announce_interval" lower="60" upper="7200" value="1800" step="30"
                                     page="300" tooltip="How often to announce to trackers (60-7200 seconds)"
                                     chars="8"/>

                            <!-- Min announce interval -->
                            <dfs-use template="spin-row-sized" label="Min announce interval (sec):" label_chars="20"
                                     id="settings_min_announce_interval" lower="10" upper="3600" value="300" step="10"
                                     page="60" tooltip="Minimum time between announces (10-3600 seconds)" chars="8"/>

                            <!-- Scrape interval -->
                            <dfs-use template="spin-row-sized" label="Scrape interval (sec):" label_chars="20"
                                     id="settings_scrape_interval" lower="60" upper="7200" value="900" step="30"
                                     page="300" tooltip="How often to scrape tracker for swarm statistics" chars="8"/>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
</object>