<?xml version="1.0" encoding="UTF-8"?>
<object class="GtkScrolledWindow" id="settings_general_scroll">
    <property name="hscrollbar-policy">never</property>
    <property name="vscrollbar-policy">automatic</property>
    <child>
        <object class="GtkBox" id="settings_general_box">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>

            <!-- Application Behavior Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Application Behavior"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Start on system startup -->
                            <dfs-use template="switch-row" id="settings_auto_start"
                                     tooltip="Start DFakeSeeder automatically when the system boots"
                                     label="Start on system startup"/>

                            <!-- Start minimized -->
                            <dfs-use template="switch-row" id="settings_start_minimized"
                                     tooltip="Start the application minimized to system tray" label="Start minimized"/>

                            <!-- Minimize to tray -->
                            <dfs-use template="switch-row" id="settings_minimize_to_tray"
                                     tooltip="Hide to system tray when window is minimized"
                                     label="Minimize to system tray"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Watch Folder Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Watch Folder"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable watch folder -->
                            <dfs-use template="switch-row" id="settings_watch_folder_enabled"
                                     tooltip="Automatically monitor a folder for new torrent files"
                                     label="Enable watch folder"/>

                            <!-- Watch folder path -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Folder path:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">15</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkBox">
                                            <property name="spacing">6</property>
                                            <property name="hexpand">True</property>
                                            <child>
                                                <object class="GtkEntry" id="settings_watch_folder_path">
                                                    <property name="tooltip-text" translatable="yes">Path to the folder to watch for torrent files</property>
                                                    <property name="hexpand">True</property>
                                                    <property name="placeholder-text" translatable="yes">Choose a folder to watch...</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkButton" id="settings_watch_folder_browse">
                                                    <property name="icon-name">folder-open-symbolic</property>
                                                    <property name="tooltip-text" translatable="yes">Browse for folder</property>
                                                </object>
                                            </child>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Scan interval -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <property name="halign">fill</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Scan interval:</property>
                                            <property name="halign">start</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">False</property>
                                            <property name="width-chars">15</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkBox">
                                            <property name="spacing">6</property>
                                            <property name="hexpand">True</property>
                                            <child>
                                                <object class="GtkSpinButton" id="settings_watch_folder_scan_interval">
                                                    <property name="adjustment">
                                                        <object class="GtkAdjustment">
                                                            <property name="lower">1</property>
                                                            <property name="upper">300</property>
                                                            <property name="step-increment">1</property>
                                                            <property name="page-increment">10</property>
                                                            <property name="value">10</property>
                                                        </object>
                                                    </property>
                                                    <property name="tooltip-text" translatable="yes">How often to check for new torrent files (in seconds)</property>
                                                    <property name="digits">0</property>
                                                    <property name="numeric">True</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkLabel">
                                                    <property name="label" translatable="yes">seconds</property>
                                                    <property name="halign">start</property>
                                                    <property name="valign">center</property>
                                                </object>
                                            </child>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Auto-start torrents -->
                            <dfs-use template="switch-row" id="settings_watch_folder_auto_start"
                                     tooltip="Automatically start torrents when added from watch folder"
                                     label="Auto-start added torrents"/>

                            <!-- Delete added torrents -->
                            <dfs-use template="switch-row" id="settings_watch_folder_delete_added"
                                     tooltip="Delete torrent files after they are successfully added"
                                     label="Delete added torrent files"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Interface Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Interface"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>

                            <!-- Theme Style selection -->
                            <dfs-use template="dropdown-row" label="Theme Style:" label_chars="15" id="settings_theme"
                                     items="System Theme|Deluge Theme|Modern Chunky"
                                     tooltip="Choose the UI theme style"/>

                            <!-- Color Scheme selection -->
                            <dfs-use template="dropdown-row" label="Color Scheme:" label_chars="15"
                                     id="settings_color_scheme" items="Auto (Follow System)|Light|Dark"
                                     tooltip="Choose light or dark color scheme"/>

                            <!-- Language selection -->
                            <dfs-use template="dropdown-row" label="Language:" label_chars="15" id="settings_language"
                                     items="English|Spanish|French|German|Italian|Portuguese|Russian|Chinese|Japanese"
                                     tooltip="Choose the interface language"/>

                            <!-- Window size persistence -->
                            <dfs-use template="switch-row" id="settings_remember_window_size"
                                     tooltip="Remember window size and position between sessions"
                                     label="Remember window size and position"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Configuration Management Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Configuration Management"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>
                            <property name="halign">start</property>

                            <!-- Export settings -->
                            <child>
                                <object class="GtkButton" id="settings_export_button">
                                    <property name="label" translatable="yes">Export Settings</property>
                                    <property name="tooltip-text" translatable="yes">Export current settings to a file</property>
                                    <child>
                                        <object class="GtkBox">
                                            <property name="spacing">6</property>
                                            <child>
                                                <object class="GtkImage">
                                                    <property name="icon-name">document-save-symbolic</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Export</property>
                                                </object>
                                            </child>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Import settings -->
                            <child>
                                <object class="GtkButton" id="settings_import_button">
                                    <property name="label" translatable="yes">Import Settings</property>
                                    <property name="tooltip-text" translatable="yes">Import settings from a file</property>
                                    <child>
                                        <object class="GtkBox">
                                            <property name="spacing">6</property>
                                            <child>
                                                <object class="GtkImage">
                                                    <property name="icon-name">document-open-symbolic</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Import</property>
                                                </object>
                                            </child>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- Reset to defaults -->
                            <child>
                                <object class="GtkButton" id="general_reset_button">
                                    <property name="label" translatable="yes">Reset to Defaults</property>
                                    <property name="tooltip-text" translatable="yes">Reset all settings to default values</property>
                                    <property name="css-classes">destructive-action</property>
                                    <child>
                                        <object class="GtkBox">
                                            <property name="spacing">6</property>
                                            <child>
                                                <object class="GtkImage">
                                                    <property name="icon-name">edit-undo-symbolic</property>
                                                </object>
                                            </child>
                                            <child>
                                                <object class="GtkLabel">
                                                    <property name="label" translatable="yes">Reset</property>
                                                </object>
                                            </child>
                                        </object>
                                    </child>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Seeding Profiles Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <dfs-use template="section-heading" title="Seeding Profiles"/>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Profile selection -->
                            <dfs-use template="dropdown-row" label="Active Profile:" label_chars="15"
                                     id="settings_seeding_profile" items="Conservative|Balanced|Aggressive|Custom"
                                     tooltip="Choose a pre-configured seeding profile"/>

                            <!-- Profile description -->
                            <child>
                                <object class="GtkLabel" id="settings_profile_description">
                                    <property name="label" translatable="yes">Conservative: Lower speeds, fewer connections, ideal for background seeding</property>
                                    <property name="halign">start</property>
                                    <property name="wrap">True</property>
                                    <property name="wrap-mode">word</property>
                                    <property name="css-classes">dim-label</property>
                                    <property name="margin-start">12</property>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
</object>