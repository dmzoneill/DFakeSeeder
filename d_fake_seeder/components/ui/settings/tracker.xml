<?xml version="1.0" encoding="UTF-8"?>
<object class="GtkScrolledWindow" id="settings_tracker_scroll">
    <property name="hscrollbar-policy">never</property>
    <property name="vscrollbar-policy">automatic</property>
    <child>
        <object class="GtkBox" id="settings_tracker_box">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">24</property>
            <property name="margin-bottom">24</property>

            <!-- Inbuilt Tracker Server Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;Inbuilt Tracker Server&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable Tracker -->
                            <dfs-use template="switch-row" id="tracker_enabled_switch"
                                     tooltip="Enable the inbuilt BitTorrent tracker server"
                                     label="Enable tracker server"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- HTTP Server Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;HTTP Server&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable HTTP -->
                            <dfs-use template="switch-row" id="tracker_http_enabled_switch"
                                     tooltip="Enable HTTP tracker protocol (BEP 3)" label="Enable HTTP tracker"/>

                            <!-- HTTP Port -->
                            <dfs-use template="spin-row-end" label="HTTP Port" id="tracker_http_port_spin" chars="6"
                                     tooltip="Port for HTTP tracker (default: 6969)" lower="1024" upper="65535"
                                     step="1" page="100" value="6969"/>

                            <!-- Bind Address -->
                            <child>
                                <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">Bind Address</property>
                                            <property name="halign">start</property>
                                            <property name="hexpand">True</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkEntry" id="tracker_bind_address_entry">
                                            <property name="valign">center</property>
                                            <property name="width-chars">15</property>
                                            <property name="text">0.0.0.0</property>
                                            <property name="tooltip-text" translatable="yes">IP address to bind to (0.0.0.0 for all interfaces)</property>
                                        </object>
                                    </child>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>

            <!-- UDP Server Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;UDP Server&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable UDP -->
                            <dfs-use template="switch-row" id="tracker_udp_enabled_switch"
                                     tooltip="Enable UDP tracker protocol (BEP 15)" label="Enable UDP tracker"/>

                            <!-- UDP Port -->
                            <dfs-use template="spin-row-end" label="UDP Port" id="tracker_udp_port_spin" chars="6"
                                     tooltip="Port for UDP tracker (default: 6969)" lower="1024" upper="65535"
                                     step="1" page="100" value="6969"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Announce Settings Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;Announce Settings&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Announce Interval -->
                            <dfs-use template="spin-row-end" label="Announce Interval (seconds)"
                                     id="tracker_announce_interval_spin" chars="6"
                                     tooltip="Time between client announces (default: 1800 = 30 minutes)" lower="60"
                                     upper="7200" step="60" page="300" value="1800"/>

                            <!-- Peer Timeout Multiplier -->
                            <dfs-use template="spin-row-end" label="Peer Timeout Multiplier"
                                     id="tracker_peer_timeout_multiplier_spin" chars="4"
                                     tooltip="Multiply announce interval for peer timeout (default: 3)" lower="2"
                                     upper="10" step="1" page="1" value="3"/>

                            <!-- Max Peers per Announce -->
                            <dfs-use template="spin-row-end" label="Max Peers per Announce"
                                     id="tracker_max_peers_spin" chars="4"
                                     tooltip="Maximum peers returned per announce (default: 50)" lower="10"
                                     upper="200" step="10" page="50" value="50"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Features Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;Features&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable Scrape -->
                            <dfs-use template="switch-row" id="tracker_enable_scrape_switch"
                                     tooltip="Enable /scrape endpoint for torrent statistics"
                                     label="Enable scrape endpoint"/>

                            <!-- Private Mode -->
                            <dfs-use template="switch-row" id="tracker_private_mode_switch"
                                     tooltip="Only allow pre-registered torrents"
                                     label="Private mode (registered torrents only)"/>

                            <!-- Log Announces -->
                            <dfs-use template="switch-row" id="tracker_log_announces_switch"
                                     tooltip="Log all announce requests (for debugging)" label="Log announces (debug)"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Self-Tracking Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;Self-Tracking&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Enable Self-Tracking -->
                            <dfs-use template="switch-row" id="tracker_self_tracking_switch"
                                     tooltip="Report own torrents to this tracker" label="Enable self-tracking"/>

                            <!-- Announce with Seeders -->
                            <dfs-use template="switch-row" id="tracker_announce_seeders_switch"
                                     tooltip="Include seeder stats in announces"
                                     label="Announce with seeder statistics"/>

                            <!-- Sync on Add -->
                            <dfs-use template="switch-row" id="tracker_sync_on_add_switch"
                                     tooltip="Register torrent with tracker when added" label="Sync on torrent add"/>

                            <!-- Sync on Remove -->
                            <dfs-use template="switch-row" id="tracker_sync_on_remove_switch"
                                     tooltip="Unregister torrent from tracker when removed"
                                     label="Sync on torrent remove"/>
                        </object>
                    </child>
                </object>
            </child>

            <!-- Security Group -->
            <child>
                <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <child>
                        <object class="GtkLabel">
                            <property name="label" translatable="yes">&lt;b&gt;Security&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="halign">start</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>

                            <!-- Rate Limit -->
                            <dfs-use template="spin-row-end" label="Rate Limit (requests/minute)"
                                     id="tracker_rate_limit_spin" chars="4"
                                     tooltip="Maximum requests per minute per IP (0 = unlimited)" lower="0"
                                     upper="1000" step="10" page="50" value="60"/>

                            <!-- IP Whitelist -->
                            <child>
                                <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">IP Whitelist (one per line, empty = allow all)</property>
                                            <property name="halign">start</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkScrolledWindow">
                                            <property name="min-content-height">60</property>
                                            <property name="max-content-height">100</property>
                                            <property name="hscrollbar-policy">never</property>
                                            <child>
                                                <object class="GtkTextView" id="tracker_ip_whitelist_textview">
                                                    <property name="monospace">True</property>
                                                    <property name="wrap-mode">none</property>
                                                    <property name="tooltip-text" translatable="yes">Only allow these IP addresses (leave empty to allow all)</property>
                                                </object>
                                            </child>
                                        </object>
                                    </child>
                                </object>
                            </child>

                            <!-- IP Blacklist -->
                            <child>
                                <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                        <object class="GtkLabel">
                                            <property name="label" translatable="yes">IP Blacklist (one per line)</property>
                                            <property name="halign">start</property>
                                        </object>
                                    </child>
                                    <child>
                                        <object class="GtkScrolledWindow">
                                            <property name="min-content-height">60</property>
                                            <property name="max-content-height">100</property>
                                            <property name="hscrollbar-policy">never</property>
                                            <child>
                                                <object class="GtkTextView" id="tracker_ip_blacklist_textview">
                                                    <property name="monospace">True</property>
                                                    <property name="wrap-mode">none</property>
                                                    <property name="tooltip-text" translatable="yes">Block these IP addresses</property>
                                                </object>
                                            </child>
                                        </object>
                                    </child>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
</object>



