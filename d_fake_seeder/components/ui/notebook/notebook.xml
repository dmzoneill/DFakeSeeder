<?xml version="1.0" encoding="UTF-8"?>

<object class="GtkNotebook" id="notebook1">
    <property name="visible">True</property>
    <property name="can-focus">True</property>
    <property name="tab-pos">left</property>
    <property name="scrollable">True</property>
    <property name="enable-popup">True</property>
    <child>
        <object class="GtkScrolledWindow">
            <property name="can-focus">False</property>
            <child>
                <object class="GtkBox" id="details_tab">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="margin-start">15</property>
                    <property name="margin-end">15</property>
                    <property name="margin-top">15</property>
                    <property name="margin-bottom">15</property>
                    <dfs-use template="empty-state" id="details_empty_state" icon="document-properties-symbolic"
                             title="No Torrent Selected" subtitle="Select a torrent to view its details"/>
                    <child>
                        <object class="GtkGrid" id="details_grid">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="row-spacing">8</property>
                            <property name="column-spacing">15</property>
                        </object>
                    </child>
                </object>
            </child>
        </object>
    </child>
    <dfs-use template="notebook-tab-label" icon="document-properties-symbolic" label="Details"/>

    <child>
        <object class="GtkScrolledWindow">
            <property name="can-focus">False</property>
            <child>
                <object class="GtkBox" id="status_tab">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="margin-start">15</property>
                    <property name="margin-end">15</property>
                    <property name="margin-top">15</property>
                    <property name="margin-bottom">15</property>
                    <dfs-use template="empty-state" id="status_empty_state" icon="view-list-symbolic"
                             title="No Torrent Selected" subtitle="Select a torrent to view its status information"/>
                </object>
            </child>
        </object>
    </child>
    <dfs-use template="notebook-tab-label" icon="view-list-symbolic" label="Status"/>

    <child>
        <object class="GtkScrolledWindow">
            <property name="can-focus">True</property>
            <property name="focusable">True</property>
            <property name="kinetic-scrolling">True</property>
            <child>
                <object class="GtkBox" id="options_tab">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="margin-start">15</property>
                    <property name="margin-end">15</property>
                    <property name="margin-top">15</property>
                    <property name="margin-bottom">15</property>
                    <dfs-use template="empty-state" id="options_empty_state" icon="emblem-system-symbolic"
                             title="No Torrent Selected" subtitle="Select a torrent to configure its options"/>
                    <child>
                        <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="options.xml"/>
                    </child>
                </object>
            </child>
        </object>
    </child>    
    <dfs-use template="notebook-tab-label" icon="emblem-system-symbolic" label="Options"/>

    <child>
        <object class="GtkScrolledWindow">
            <property name="can-focus">False</property>
            <child>
                <object class="GtkBox" id="files_tab">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="margin-start">15</property>
                    <property name="margin-end">15</property>
                    <property name="margin-top">15</property>
                    <property name="margin-bottom">15</property>
                    <dfs-use template="empty-state" id="files_empty_state" icon="folder-documents-symbolic"
                             title="No Torrent Selected" subtitle="Select a torrent to view its files"/>
                </object>
            </child>
        </object>
    </child>
    <dfs-use template="notebook-tab-label" icon="folder-documents-symbolic" label="Files"/>

    <child>
        <object class="GtkScrolledWindow">
            <property name="can-focus">False</property>
            <child>
                <object class="GtkBox" id="peers_tab">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="margin-start">15</property>
                    <property name="margin-end">15</property>
                    <property name="margin-top">15</property>
                    <property name="margin-bottom">15</property>
                    <dfs-use template="empty-state" id="peers_empty_state" icon="network-workgroup-symbolic"
                             title="No Torrent Selected" subtitle="Select a torrent to view its peers"/>
                    <child>
                        <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="peers.xml"/>
                    </child>
                </object>
            </child>
        </object>
    </child>
    <dfs-use template="notebook-tab-label" icon="network-workgroup-symbolic" label="Peers"/>

    <child>
        <object class="GtkScrolledWindow">
            <property name="can-focus">False</property>
            <child>
                <object class="GtkBox" id="incoming_tab">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="margin-start">15</property>
                    <property name="margin-end">15</property>
                    <property name="margin-top">15</property>
                    <property name="margin-bottom">15</property>
                    <child>
                        <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="incoming_connections.xml"/>
                    </child>
                </object>
            </child>
        </object>
    </child>
    <dfs-use template="notebook-tab-label" icon="network-receive-symbolic" label="Incoming"/>

    <child>
        <object class="GtkScrolledWindow">
            <property name="can-focus">False</property>
            <child>
                <object class="GtkBox" id="outgoing_tab">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="margin-start">15</property>
                    <property name="margin-end">15</property>
                    <property name="margin-top">15</property>
                    <property name="margin-bottom">15</property>
                    <child>
                        <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="outgoing_connections.xml"/>
                    </child>
                </object>
            </child>
        </object>
    </child>
    <dfs-use template="notebook-tab-label" icon="network-transmit-symbolic" label="Outgoing"/>

    <child>
        <object class="GtkScrolledWindow">
            <property name="can-focus">False</property>
            <child>
                <object class="GtkBox" id="trackers_tab">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="margin-start">15</property>
                    <property name="margin-end">15</property>
                    <property name="margin-top">15</property>
                    <property name="margin-bottom">15</property>
                    <dfs-use template="empty-state" id="trackers_empty_state" icon="network-server-symbolic"
                             title="No Torrent Selected" subtitle="Select a torrent to view its trackers"/>
                </object>
            </child>
        </object>
    </child>
    <dfs-use template="notebook-tab-label" icon="network-server-symbolic" label="Trackers"/>

</object>